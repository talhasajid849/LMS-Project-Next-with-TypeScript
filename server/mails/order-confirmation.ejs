<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f4f4f4;
            line-height: 1.4;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background-color: #007bff;
            color: #ffffff;
            padding: 20px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
        }
        .content {
            padding: 30px 20px;
        }
        .order-info {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }
        .order-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .order-table th,
        .order-table td {
            padding: 12px 8px;
            text-align: left;
            border-bottom: 1px solid #dee2e6;
        }
        .order-table th {
            background-color: #e9ecef;
            font-weight: bold;
        }
        .item-row {
            border-bottom: 2px solid #dee2e6;
        }
        .price {
            font-weight: bold;
            color: #007bff;
        }
        .total-row {
            background-color: #e9ecef;
            font-weight: bold;
        }
        .total-row td {
            padding: 15px 8px;
            border-top: 2px solid #007bff;
        }
        .cta-button {
            display: inline-block;
            background-color: #28a745;
            color: #ffffff;
            padding: 12px 24px;
            text-decoration: none;
            border-radius: 5px;
            font-size: 16px;
            margin: 20px 0;
        }
        .footer {
            background-color: #f8f9fa;
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: #6c757d;
            border-top: 1px solid #dee2e6;
        }
        @media screen and (max-width: 600px) {
            .container {
                width: 100% !important;
            }
            .content {
                padding: 20px 15px;
            }
            .order-table th,
            .order-table td {
                display: block;
                width: 100%;
                padding: 8px 0;
            }
            .order-table thead {
                display: none;
            }
            .order-table tr {
                border: 1px solid #dee2e6;
                margin-bottom: 10px;
                padding: 10px;
                border-radius: 5px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Your Order is Confirmed!</h1>
            <p>We're just as excited as you are!</p>
        </div>
        
        <div class="content">
            <div class="order-info">
                <h2>Order Details</h2>
                <p>Order #: <%= order.id %></p>
                <p>Order Date: <%= order.date %></p>
            </div>
            
            <table class="order-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(function(item) { %>
                    <tr class="item-row">
                        <td><%= item.name %></td>
                        <td><%= item.qty %></td>
                        <td class="price"><%= item.price %></td>
                    </tr>
                    <% }); %>
                    <tr class="total-row">
                        <td colspan="2">Total</td>
                        <td class="price"><%= order.total %></td>
                    </tr>
                </tbody>
            </table>
            
            <a href="<%= order.trackUrl %>" class="cta-button">Track Your Order</a>
            
            <p>Thank you for your purchase! If you have any questions, please contact our support team.</p>
        </div>
        
        <div class="footer">
            <p>&copy; 2025 Your Company. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
